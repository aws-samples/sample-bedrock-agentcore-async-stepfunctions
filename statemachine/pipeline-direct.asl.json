{
  "Comment": "Document pipeline (DIRECT): demonstrates calling Bedrock AgentCore DIRECTLY from Step Functions, via SDK integration (invokeAgentRuntime), with NO Lambda dispatcher. Extract -> Identify -> ValidateDirect (AgentCore) -> PipelineCompleted.",
  "StartAt": "Extract",
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "OCR/extraction (Lambda simulates 2s)",
      "Parameters": {
        "FunctionName": "${ExtractFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed" }
      ],
      "Next": "Identify"
    },

    "Identify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Classifies the document (synchronous Lambda, sleep 2s).",
      "Parameters": {
        "FunctionName": "${IdentifyFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed" }
      ],
      "Next": "ValidateDirect"
    },

    "ValidateDirect": {
      "Type": "Task",
      "Comment": "DIRECT CALL TO AGENTCORE — no Lambda. SDK integration invokeAgentRuntime (synchronous request-response). Step Functions waits for the agent to respond (~15s) and receives the verdict directly in the result. Compare with the version using Lambda dispatcher + waitForTaskToken.",
      "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:invokeAgentRuntime",
      "Parameters": {
        "AgentRuntimeArn": "${AgentRuntimeArn}",
        "RuntimeSessionId.$": "States.Hash($$.Execution.Id, 'SHA-256')",
        "Payload.$": "States.JsonToString($)"
      },
      "ResultSelector": {
        "raw.$": "$.Response"
      },
      "ResultPath": "$.agentRaw",
      "TimeoutSeconds": 120,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed" }
      ],
      "Next": "ParseAgentResponse"
    },

    "ParseAgentResponse": {
      "Type": "Pass",
      "Comment": "The Response comes as a JSON string (e.g. {\"validation\": {...}}); converts it to an object and exposes the verdict at $.validation.",
      "Parameters": {
        "parsed.$": "States.StringToJson($.agentRaw.raw)"
      },
      "ResultPath": "$.agentParsed",
      "Next": "ExtractVerdict"
    },

    "ExtractVerdict": {
      "Type": "Pass",
      "Comment": "Promotes the agent verdict to $.validation (same shape as the Lambda version).",
      "Parameters": {
        "validation.$": "$.agentParsed.parsed.validation"
      },
      "ResultPath": "$.result",
      "Next": "PipelineCompleted"
    },

    "PipelineCompleted": {
      "Type": "Succeed",
      "Comment": "Flow (direct) completed successfully"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "CausePath": "States.JsonToString($.error)"
    }
  }
}
