{
  "Comment": "Document pipeline: Extract -> Identify(sync) -> RouteAfterIdentify -> (Parallel | OrganizeSolo | ValidateSolo[waitForTaskToken/AgentCore]) -> PipelineCompleted. Global catch -> PipelineFailed.",
  "StartAt": "Extract",
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "OCR/extraction (Lambda simulates 2s + structured logs)",
      "Parameters": {
        "FunctionName": "${ExtractFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "Identify"
    },

    "Identify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Classifies the document and decides the routing flags (synchronous Lambda, sleep 2s). Does not call the agent.",
      "Parameters": {
        "FunctionName": "${IdentifyFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "RouteAfterIdentify"
    },

    "RouteAfterIdentify": {
      "Type": "Choice",
      "Comment": "Routes based on the flags returned by Identify",
      "Choices": [
        {
          "And": [
            { "Variable": "$.identify.shouldOrganize", "BooleanEquals": true },
            { "Variable": "$.identify.shouldValidate", "BooleanEquals": true }
          ],
          "Next": "OrganizeAndValidateParallel"
        },
        {
          "Variable": "$.identify.shouldOrganize",
          "BooleanEquals": true,
          "Next": "OrganizeSolo"
        },
        {
          "Variable": "$.identify.shouldValidate",
          "BooleanEquals": true,
          "Next": "ValidateSolo"
        }
      ],
      "Default": "PipelineCompleted"
    },

    "OrganizeAndValidateParallel": {
      "Type": "Parallel",
      "Comment": "Organize + Validate in parallel (both flags true)",
      "ResultPath": "$.parallelResult",
      "Branches": [
        {
          "StartAt": "Organize",
          "States": {
            "Organize": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${OrganizeFunctionArn}",
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "End": true
            }
          }
        },
        {
          "StartAt": "ValidateDispatch",
          "States": {
            "ValidateDispatch": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Comment": "STEP BEFORE THE AGENT (Validate branch, next to Organize). Dispatches the agent (validate_dispatcher) passing the taskToken and RETURNS immediately — the Lambda dies in ~1-4s. This Parallel branch SLEEPS (at no cost) until the agent calls SendTaskSuccess (~15s). No Lambda stays alive during that period.",
              "Parameters": {
                "FunctionName": "${ValidateDispatcherFunctionArn}",
                "Payload": {
                  "taskToken.$": "$$.Task.Token",
                  "document.$": "$.document",
                  "extractedText.$": "$.extract.extractedText",
                  "executionId.$": "$$.Execution.Id"
                }
              },
              "TimeoutSeconds": 120,
              "HeartbeatSeconds": 60,
              "ResultPath": "$.validation",
              "Next": "AgentCoreValidation"
            },
            "AgentCoreValidation": {
              "Type": "Pass",
              "Comment": "VISUAL: represents the Bedrock AgentCore processing (~15s). While this 'node' is active, ValidateDispatch has already finished (waitForTaskToken) and no Lambda is alive — the agent validates the document and wakes the flow via SendTaskSuccess. A Pass state adds no cost and does not change the data.",
              "Next": "ValidateResult"
            },
            "ValidateResult": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Comment": "STEP AFTER THE AGENT. Runs when the branch WAKES UP (after the callback). A NEW Lambda processes the verdict returned by the agent. Proves logic before and after, without keeping a Lambda alive during the agent processing.",
              "Parameters": {
                "FunctionName": "${ValidateResultFunctionArn}",
                "Payload.$": "$"
              },
              "OutputPath": "$.Payload",
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineCompleted"
    },

    "OrganizeSolo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrganizeFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineCompleted"
    },

    "ValidateSolo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "'Light' validation when only shouldValidate=true (without organizing). Simple Lambda (sleep 2s). Agent-based validation happens in the Validate branch of the Parallel.",
      "Parameters": {
        "FunctionName": "${ValidateFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineCompleted"
    },

    "PipelineCompleted": {
      "Type": "Succeed",
      "Comment": "Flow completed successfully"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Comment": "Failure in some pipeline step",
      "Error": "PipelineError",
      "CausePath": "States.JsonToString($.error)"
    }
  }
}
